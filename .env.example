# Obligatorios para flujo completo
GROQ_API_KEY=
HF_TOKEN=

# PulseAudio (obligatorios para grabar)
GRABA_MIC=
GRABA_MON=

# Groq (minuta y título)
GRABA_GROQ_MODEL=llama-3.3-70b-versatile

# WhisperX (transcripción + diarización, modo default)
GRABA_WHISPERX_MODEL=large-v3
GRABA_WHISPERX_LANGUAGE=es
GRABA_WHISPERX_DEVICE=cuda
GRABA_WHISPERX_COMPUTE_TYPE=float16
GRABA_WHISPERX_BATCH_SIZE=16

# faster-whisper (solo --no-diarize)
GRABA_MODEL=large-v3
GRABA_LANGUAGE=es

# Rutas
GRABA_DB=
